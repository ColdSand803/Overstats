# ==============================================================================
# Overstats 环境变量配置文件模板 (.env.example)
# 使用方式: 复制本文件为 .env，并按需填入实际配置与凭据
# ==============================================================================

# ======================= 核心服务配置 ====================== #
# API 服务监听地址与端口
API_HOST=127.0.0.1
API_PORT=18080

# 是否启用流式响应 (true/false)
USE_STREAM_RESPONSE=true

# 是否允许向数据库写入数据 (true/false)
ENABLE_DATABASE_WRITE=true

# 在使用大神数据或素材的渲染图片底部显示战绩查询宣传横幅 (true/false)
SHOW_DASHEN_PROMO=false

# 英雄树状图数据源: 0 = 网易大神, 1 = 微信小程序
HERO_MODULE_MODE=0

# 是否在后台自动下载游戏静态素材 (共 1729 张图片)
# 设为 false 可完全关闭后台下载，避免消耗移动数据或有限流量
ENABLE_ASSET_WARMUP=false

# ======================= 网易大神账号与凭据 ====================== #
# 方式一：单账号快捷配置 (推荐个人用户)
DASHEN_ROLE_ID=
DASHEN_TOKEN=
DASHEN_ACCOUNT_NAME=primary

# 方式二：多账号配置 (JSON 数组，配置了多账号时优先使用)
# DASHEN_ACCOUNTS=[{"name":"account-1","role_id":123456789,"token":"token-1"},{"name":"account-2","role_id":987654321,"token":"token-2"}]

# 大神请求基础参数
DASHEN_DTS=2026
DASHEN_SERVER=1
DASHEN_ACCOUNT_MAX_REQUESTS_PER_SECOND=5
DASHEN_ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=1.0
DASHEN_CLIENT_TYPE=60
DASHEN_ORIGIN=https://act.ds.163.com
DASHEN_REFERER=https://act.ds.163.com/
DASHEN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; WOW64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/108.0.0.0 Safari/537.36 app/df_client dfVersion/100111
DASHEN_ACCOUNT_FAILURE_COOLDOWN_SECONDS=60
DASHEN_MAX_CONCURRENT_REQUESTS=2
# 最大允许排队与执行请求数，留空时默认为 账号数 * 4
# DASHEN_MAX_ACCEPTED_REQUESTS=4

# 代理设置 (可选)
DASHEN_INTERNATIONAL_PROXY=
# 网易接口代理池 (多代理可用逗号分隔，如 http://proxy1:port,http://proxy2:port)
DASHEN_NETEASE_PROXIES=

# ======================= 外部 API 与 赛季 ====================== #
# 守望先锋赛事 PandaScore API Key (访问 https://app.pandascore.co/dashboard/main 注册获取，每小时1000次免费调用)
OW_ESPORTS_API_KEY=

# 守望先锋猜谜素材根目录 (默认位于项目根目录的 ow_guess_assets)
OW_GUESS_ASSET_ROOT=ow_guess_assets

# 大神赛季配置
DASHEN_CURRENT_SEASON=25
DASHEN_HISTORY_START_SEASON=15

# 国服英雄排行榜赛季
OW_HERO_LEADERBOARD_CN_SEASON=5

# ======================= AI 对局分析 (Match Analysis) ====================== #
# OpenAI 兼容接口地址 (例如: https://api.deepseek.com/v1 或 https://api.openai.com/v1)
ANALYSIS_BASE_URL=
# 分析服务 API Key
ANALYSIS_API_KEY=
# AI 接口网络代理 (可选)
ANALYSIS_PROXY=

# 模型选择
ANALYSIS_OPENAI_MODEL=
ANALYSIS_DEEPSEEK_MODEL=
ANALYSIS_GOOGLE_MODEL=

# ======================= 补丁与英雄 Wiki 抓取 ====================== #
PATCH_NOTES_USE_INTERNATIONAL_PROXY=false
PATCH_NOTES_INTERNATIONAL_PROXY=

# ======================= 人设提示词 (可选) ====================== #
# ANALYSIS_PERSONA_PROMPT=
